# Configure these as encrypted Vercel project environment variables.
LITEUP_DB_HOST=
LITEUP_DB_PORT=4000
LITEUP_DB_USER=
LITEUP_DB_PASSWORD=
LITEUP_DB_NAME=
LITEUP_DB_TLS=true
LITEUP_DB_SSL_CA_FILE=

# Connect a private Vercel Blob store to the Vercel project.
# Vercel supplies BLOB_READ_WRITE_TOKEN when the private store is connected.
LITEUP_STORAGE_SERVICE_TOKEN=

# Set this to the Vercel deployment URL if automatic host detection is unsuitable.
# Example: https://your-project.vercel.app/api/blob
LITEUP_STORAGE_API_URL=

# Mail settings used by PHPMailer.
MAIL_HOST=
MAIL_PORT=587
MAIL_EMAIL=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=LiteUp
